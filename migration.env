# Per-CMS settings read by scripts/ (bash: sourced; Python: parsed as KEY=value).
# No secrets here: those stay in the gitignored .env.fly, .env.fly.prod and .env.backup.
# For another CMS, copy this file with the scripts and edit every value.
# See docs/migration-playbook.md.

# Website repo (path relative to this repo) and its public URL
SITE_DIR=../site
SITE_URL=https://familyforestcarbon.org

# Production CMS domain: the old VPS until the DNS switch, Fly after it
PROD_DOMAIN=cms.familyforestcarbon.org
# Old assets domain, retired at cutover (leave empty if there is none)
OLD_ASSETS_DOMAIN=assets.familyforestcarbon.org

# Fly apps: production, and the test app with its custom domain
FLY_APP=ffcp-cms
FLY_TEST_APP=ffcp-cms-test
TEST_DOMAIN=ffcp-cms-test.tupp.dev

# Old CMS on the VPS (Dokploy)
VPS_SSH=netcup                              # ssh host alias in ~/.ssh/config
VPS_IP=152.53.241.119                       # public IP the old CMS answers on
VPS_PG_SERVICE=ffcp-cms-postgres-qylwxv     # Postgres Swarm service name
VPS_DB=directus                             # database name inside it
VPS_VOLUME_PREFIX=ffcp-cms-directus-qrsqmy  # Directus compose project (volume name prefix)
VPS_BACKUP_DIR=ffcp-backup                  # backup folder in the VPS user's home
