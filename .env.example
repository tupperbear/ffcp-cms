# Copy to .env and fill in. Never commit .env.

# Directus
DIRECTUS_SECRET=""
DIRECTUS_PUBLIC_URL=""
DIRECTUS_ADMIN_EMAIL=""
DIRECTUS_ADMIN_PASSWORD=""

# Database
DATABASE_URL="postgres://user:password@host:5432/directus"
DATABASE_PASSWORD=""  # docker-compose.local.yml only

# Email (docker-compose.yml)
EMAIL_FROM=""
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""

# Email (docker-compose.local.yml)
SMTP_TOKEN=""

# Assets storage bucket (R2)
R2A_KEY=""
R2A_SECRET=""
R2A_BUCKET=""
R2A_REGION="auto"
R2A_ENDPOINT=""

# Extensions storage bucket (R2)
R2E_KEY=""
R2E_SECRET=""
R2E_BUCKET=""
R2E_REGION="auto"
R2E_ENDPOINT=""
